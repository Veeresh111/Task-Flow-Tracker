## SECTION 7: Recommended Database Relationships

### 7.1 Core Tables with Proper Relationships

```sql
-- Organization hierarchy
CREATE TABLE departments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name TEXT NOT NULL UNIQUE,
    head_id UUID REFERENCES profiles(id),
    created_at TIMESTAMPTZ DEFAULT now(),
    updated_at TIMESTAMPTZ DEFAULT now()
);

-- Unified profile with proper constraints
CREATE TABLE profiles (
    id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
    email TEXT NOT NULL UNIQUE,
    full_name TEXT NOT NULL,
    phone TEXT,
    role TEXT NOT NULL CHECK (role IN ('admin','hr','team_lead','employee','candidate')),
    department_id UUID REFERENCES departments(id),
    reporting_manager_id UUID REFERENCES profiles(id),
    employment_status TEXT DEFAULT 'active' CHECK (employment_status IN ('active','on_leave','probation','terminated','resigned')),
    date_of_joining DATE,
    employee_code TEXT UNIQUE,
    created_at TIMESTAMPTZ DEFAULT now(),
    updated_at TIMESTAMPTZ DEFAULT now()
);

-- Separate candidate profile
CREATE TABLE candidates (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    profile_id UUID REFERENCES profiles(id), -- Only after registration
    full_name TEXT NOT NULL,
    email TEXT NOT NULL,
    phone TEXT,
    resume_url TEXT,
    source TEXT, -- 'career_portal', 'referral', 'job_board'
    created_at TIMESTAMPTZ DEFAULT now(),
    UNIQUE(email)
);

-- Job lifecycle
CREATE TABLE job_requisitions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    title TEXT NOT NULL,
    department_id UUID REFERENCES departments(id),
    requested_by UUID REFERENCES profiles(id),
    approved_by UUID REFERENCES profiles(id),
    status TEXT DEFAULT 'draft' CHECK (status IN ('draft','pending_approval','approved','published','closed','cancelled')),
    headcount INTEGER DEFAULT 1,
    created_at TIMESTAMPTZ DEFAULT now(),
    updated_at TIMESTAMPTZ DEFAULT now()
);

CREATE TABLE job_postings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    requisition_id UUID REFERENCES job_requisitions(id) NOT NULL,
    jd_text TEXT NOT NULL,
    form_schema JSONB DEFAULT '[]',
    requires_assessment BOOLEAN DEFAULT false,
    is_active BOOLEAN DEFAULT true,
    published_at TIMESTAMPTZ,
    expires_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT now()
);

-- Single source of truth for applications
CREATE TABLE applications (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    candidate_id UUID REFERENCES candidates(id) NOT NULL,
    job_posting_id UUID REFERENCES job_postings(id) NOT NULL,
    answers JSONB DEFAULT '{}',
    resume_url TEXT,
    ai_score INTEGER CHECK (ai_score BETWEEN 0 AND 100),
    ai_verdict TEXT,
    stage TEXT DEFAULT 'applied' CHECK (stage IN (
        'applied','screening','shortlisted','assessment','interview',
        'offer_pending','offer_sent','offer_accepted','offer_declined',
        'onboarding','hired','rejected','withdrawn'
    )),
    rejection_reason TEXT,
    created_at TIMESTAMPTZ DEFAULT now(),
    updated_at TIMESTAMPTZ DEFAULT now(),
    UNIQUE(candidate_id, job_posting_id) -- Prevent duplicate applications
);

-- Assessment assignment (one per application)
CREATE TABLE assessment_assignments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    application_id UUID REFERENCES applications(id) NOT NULL,
    assessment_id UUID REFERENCES assessments(id) NOT NULL,
    access_token TEXT UNIQUE NOT NULL DEFAULT gen_random_uuid()::text,
    status TEXT DEFAULT 'assigned' CHECK (status IN ('assigned','in_progress','completed','expired')),
    score INTEGER,
    started_at TIMESTAMPTZ,
    completed_at TIMESTAMPTZ,
    expires_at TIMESTAMPTZ NOT NULL,
    created_at TIMESTAMPTZ DEFAULT now(),
    UNIQUE(application_id, assessment_id)
);

-- Interview rounds (multiple per application)
CREATE TABLE interview_rounds (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    application_id UUID REFERENCES applications(id) NOT NULL,
    round_number INTEGER NOT NULL,
    round_type TEXT CHECK (round_type IN ('phone_screen','technical','behavioral','culture_fit','final','hr')),
    interviewer_id UUID REFERENCES profiles(id),
    scheduled_at TIMESTAMPTZ NOT NULL,
    meeting_link TEXT,
    meeting_provider TEXT,
    status TEXT DEFAULT 'scheduled' CHECK (status IN ('scheduled','in_progress','completed','cancelled','no_show')),
    overall_score INTEGER CHECK (overall_score BETWEEN 0 AND 100),
    feedback JSONB, -- {communication: 80, technical: 90, ...}
    recommendation TEXT CHECK (recommendation IN ('strong_hire','hire','no_hire','strong_no_hire')),
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT now()
);

-- Offer management
CREATE TABLE offer_letters (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    application_id UUID REFERENCES applications(id) NOT NULL UNIQUE,
    candidate_id UUID REFERENCES candidates(id) NOT NULL,
    offered_ctc DECIMAL NOT NULL,
    joining_date DATE NOT NULL,
    designation TEXT NOT NULL,
    department_id UUID REFERENCES departments(id),
    reporting_to UUID REFERENCES profiles(id),
    offer_document_url TEXT,
    status TEXT DEFAULT 'draft' CHECK (status IN ('draft','pending_approval','approved','sent','accepted','declined','revoked')),
    approved_by UUID REFERENCES profiles(id),
    sent_at TIMESTAMPTZ,
    response_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT now()
);

-- Payroll (actual records, not calculated)
CREATE TABLE payroll_records (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    employee_id UUID REFERENCES profiles(id) NOT NULL,
    pay_period_start DATE NOT NULL,
    pay_period_end DATE NOT NULL,
    basic_pay DECIMAL NOT NULL,
    hra DECIMAL DEFAULT 0,
    transport_allowance DECIMAL DEFAULT 0,
    dearness_allowance DECIMAL DEFAULT 0,
    variable_pay DECIMAL DEFAULT 0,
    gross_pay DECIMAL NOT NULL,
    income_tax DECIMAL DEFAULT 0,
    provident_fund DECIMAL DEFAULT 0,
    professional_tax DECIMAL DEFAULT 0,
    total_deductions DECIMAL NOT NULL,
    net_pay DECIMAL NOT NULL,
    status TEXT DEFAULT 'draft' CHECK (status IN ('draft','processed','approved','disbursed')),
    processed_by UUID REFERENCES profiles(id),
    disbursed_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ DEFAULT now(),
    UNIQUE(employee_id, pay_period_start, pay_period_end)
);

-- Audit trail
CREATE TABLE audit_log (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    actor_id UUID REFERENCES profiles(id),
    action TEXT NOT NULL,
    entity_type TEXT NOT NULL,
    entity_id UUID NOT NULL,
    old_values JSONB,
    new_values JSONB,
    ip_address INET,
    created_at TIMESTAMPTZ DEFAULT now()
);

-- Required indexes
CREATE INDEX idx_applications_candidate ON applications(candidate_id);
CREATE INDEX idx_applications_posting ON applications(job_posting_id);
CREATE INDEX idx_applications_stage ON applications(stage);
CREATE INDEX idx_payroll_employee ON payroll_records(employee_id);
CREATE INDEX idx_payroll_period ON payroll_records(pay_period_start, pay_period_end);
CREATE INDEX idx_audit_entity ON audit_log(entity_type, entity_id);
CREATE INDEX idx_profiles_role ON profiles(role);
CREATE INDEX idx_profiles_department ON profiles(department_id);
CREATE INDEX idx_work_sessions_user ON work_sessions(employee_id, status);
```

### 7.2 Required RLS Policies

```sql
-- Example: Employees can only see their own payroll
CREATE POLICY payroll_employee_access ON payroll_records
  FOR SELECT USING (
    employee_id = auth.uid()
    OR (auth.jwt() -> 'app_metadata' ->> 'role') IN ('admin', 'hr')
  );

-- Candidates can only see their own applications
CREATE POLICY application_candidate_access ON applications
  FOR SELECT USING (
    candidate_id IN (SELECT id FROM candidates WHERE profile_id = auth.uid())
    OR (auth.jwt() -> 'app_metadata' ->> 'role') IN ('admin', 'hr')
  );

-- Only HR/Admin can modify applications
CREATE POLICY application_modify ON applications
  FOR UPDATE USING (
    (auth.jwt() -> 'app_metadata' ->> 'role') IN ('admin', 'hr')
  );
```

