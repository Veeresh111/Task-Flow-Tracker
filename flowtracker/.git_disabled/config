[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/Veeresh111/Task-Flow-Tracker.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/backend-development
[branch "backend-development"]
	remote = origin
	merge = refs/heads/backend-development
	vscode-merge-base = origin/backend-development
[branch "main"]
	vscode-merge-base = origin/main
[branch "full-stack"]
	vscode-merge-base = origin/main
