# ============================================================
# AI HRMS (FlowTracker) — Environment Variable Placeholders
# ============================================================
# This file contains NO secrets. Copy to .env.local and fill values locally.
# .env / .env.local are gitignored; this file is tracked intentionally.

# --- Frontend (browser-safe, public by design) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase Management (CLI operations: db push, functions deploy) ---
# Personal access token from Supabase dashboard → Account → Access Tokens.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Email provider (Edge Function secrets, server-side only) ---
# Configured via: npx supabase secrets set --project-ref <ref>
# NEVER as VITE_* variables. Provider selection is EXPLICIT — the worker
# refuses to start when EMAIL_PROVIDER is missing/invalid or its key is unset.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# Legacy rollback alternative: EMAIL_PROVIDER=resend + RESEND_API_KEY=
RESEND_API_KEY=
# Sender identity, e.g. "AI HRMS <your-address@gmail.com>"
EMAIL_FROM=
# Shared secret for pg_cron → worker invocation (vault: email_cron_secret)
EMAIL_CRON_SECRET=
# Application-level daily safety cap (NOT a provider guarantee)
EMAIL_DAILY_SAFETY_LIMIT=80
